---
import '@/styles/tokens.css';
import '@/styles/fonts.css';
import '@/styles/base.css';
import '@/styles/utilities.css';
import '@/styles/motion.css';

import SkipLink from '@/components/layout/SkipLink.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { site } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  includeChrome?: boolean;
}

const {
  title = site.seo.title,
  description = site.seo.description,
  noindex = false,
  includeChrome = true,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? site.siteUrl).toString();
const ogImageURL = new URL(site.seo.ogImage, Astro.site ?? site.siteUrl).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.officialName,
  alternateName: site.shortName,
  description: site.seo.description,
  url: site.siteUrl,
  sameAs: [site.channels.instagram.url, site.channels.linkedin.url],
};
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.seo.locale} />
    <meta property="og:site_name" content={site.officialName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="EF Hult Prize at Universidad Tecnológica del Perú — Las ideas que cambian el mundo empiezan aquí."
    />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <meta name="theme-color" content="#150007" />

    <!-- Datos estructurados JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Marca progresiva de soporte JS sin bloquear renderizado -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <SkipLink />
    {includeChrome && <Header />}
    <main id="contenido-principal">
      <slot />
    </main>
    {includeChrome && <Footer />}

    <script>
      import { initHeader } from '@/scripts/header';
      import { initMobileMenu } from '@/scripts/menu';
      import { initReveal } from '@/scripts/reveal';
      import { initFaq } from '@/scripts/faq';

      function boot() {
        initHeader();
        initMobileMenu();
        initReveal();
        initFaq();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
      } else {
        boot();
      }
    </script>
  </body>
</html>

