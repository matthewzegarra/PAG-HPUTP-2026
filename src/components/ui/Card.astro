---
interface Props {
  tone?: 'light' | 'dark';
  interactive?: boolean;
  class?: string;
}

const { tone = 'light', interactive = true, class: className = '' } = Astro.props;
---

<article
  class:list={[
    'ui-card',
    `ui-card--${tone}`,
    { 'ui-card--interactive': interactive },
    className,
  ]}
>
  <slot />
</article>

<style>
  .ui-card {
    position: relative;
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 2.5vw, 2.25rem);
    transition:
      transform var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
    overflow: hidden;
  }

  .ui-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--grad-citypop);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .ui-card--light {
    background-color: var(--gallery);
    border: 1px solid var(--border-on-light);
    color: var(--text-on-light);
  }

  .ui-card--dark {
    background-color: var(--ink-elevated);
    border: 1px solid var(--border-on-dark);
    color: var(--text-on-dark);
  }

  .ui-card--interactive:hover {
    transform: translateY(-3px);
  }

  .ui-card--light.ui-card--interactive:hover {
    border-color: var(--border-on-light-strong);
    box-shadow: var(--shadow-soft);
  }

  .ui-card--dark.ui-card--interactive:hover {
    border-color: var(--border-on-dark-strong);
    box-shadow: var(--shadow-dark);
  }

  .ui-card--interactive:hover::before {
    transform: scaleX(1);
  }
</style>

