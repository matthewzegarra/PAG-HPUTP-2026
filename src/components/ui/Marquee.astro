---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<div class="ui-marquee" aria-label="Valores de EF Hult Prize at Universidad Tecnológica del Perú">
  <div class="ui-marquee__track">
    <ul class="ui-marquee__list">
      {
        items.map((item) => (
          <li class="ui-marquee__item">
            <span class="ui-marquee__bullet" aria-hidden="true" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
    <ul class="ui-marquee__list" aria-hidden="true">
      {
        items.map((item) => (
          <li class="ui-marquee__item">
            <span class="ui-marquee__bullet" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .ui-marquee {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-top: 1px solid var(--border-on-dark);
    border-bottom: 1px solid var(--border-on-dark);
    background-color: rgba(21, 0, 7, 0.72);
    backdrop-filter: blur(8px);
    padding-block: 0.95rem;
    z-index: 3;
  }

  .ui-marquee__track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 34s linear infinite;
  }

  .ui-marquee:hover .ui-marquee__track,
  .ui-marquee:focus-within .ui-marquee__track {
    animation-play-state: paused;
  }

  .ui-marquee__list {
    display: flex;
    align-items: center;
    gap: 2.25rem;
    padding-right: 2.25rem;
  }

  .ui-marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-on-dark-muted);
    white-space: nowrap;
  }

  .ui-marquee__bullet {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--heritage);
  }

  @media (prefers-reduced-motion: reduce) {
    .ui-marquee__track {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
      justify-content: center;
    }

    .ui-marquee__list[aria-hidden='true'] {
      display: none;
    }
  }
</style>

